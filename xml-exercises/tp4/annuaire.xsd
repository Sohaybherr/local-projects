<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:complexType name="numerosType">
        <xs:sequence>
            <xs:element name="telephone" type="xs:string" minOccurs="0"></xs:element>
            <xs:element name="email" type="xs:string" maxOccurs="unbounded"></xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="contactType">
        <xs:sequence>
            <xs:element name="nom" type="xs:string"></xs:element>
            <xs:element name="prenom" type="xs:string"></xs:element>
            <xs:element name="numeros" type="numerosType"></xs:element>
        </xs:sequence>   
    </xs:complexType>
    <xs:element name="contact" type="contactType"></xs:element>
</xs:schema>