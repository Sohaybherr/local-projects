<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
   <xs:simpleType name="cateType">
    <xs:restriction base="xs:string">
        <xs:enumeration value="laptop"></xs:enumeration>
        <xs:enumeration value="phone"></xs:enumeration>
        <xs:enumeration value="accessory"></xs:enumeration>
    </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="posType">
    <xs:restriction base="xs:decimal">
        <xs:minInclusive value="0"></xs:minInclusive>
    </xs:restriction>
   </xs:simpleType>
    <xs:simpleType name="currType">
    <xs:restriction base="xs:string">
        <xs:enumeration value="MAD"></xs:enumeration>
        <xs:enumeration value="USD"></xs:enumeration>
        <xs:enumeration value="EUR"></xs:enumeration>
    </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="stsType">
    <xs:restriction base="xs:string">
        <xs:enumeration value="regular"></xs:enumeration>
        <xs:enumeration value="vip"></xs:enumeration>
    </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="emailType">
    <xs:restriction base="xs:string">
        <xs:pattern value="[A-Za-z].+[a-zA-z0-9,^_+-]+.+@.+[a-z]+.+\..+[a-z]+"></xs:pattern>
    </xs:restriction>
   </xs:simpleType>
   <xs:simpleType name="plusType">
    <xs:restriction base="xs:decimal">
        <xs:minInclusive value="1"></xs:minInclusive>
    </xs:restriction>
   </xs:simpleType>
   <xs:complexType name="prodType">
    <xs:sequence>
        <xs:element name="label"></xs:element>
        <xs:element name="price">
            <xs:complexType>
                <xs:simpleContent>
                    <xs:extension base="posType">
                        <xs:attribute name="currency" type="currType" use="required"></xs:attribute>
                    </xs:extension>
                </xs:simpleContent>
            </xs:complexType>
        </xs:element>
        <xs:element name="stock" type="posType"></xs:element>
    </xs:sequence>
    <xs:attribute name="category" type="cateType" use="required"></xs:attribute>
    <xs:attribute name="sku" type="xs:ID" use="required"></xs:attribute>
   </xs:complexType>
   <xs:complexType name="costumType">
    <xs:sequence>
        <xs:element name="fullname" type="xs:string"></xs:element>
        <xs:element name="email" type="emailType"></xs:element>
    </xs:sequence>
    <xs:attribute name="status" type="stsType" use="required"></xs:attribute>
    <xs:attribute name="id" type="xs:ID" use="required"></xs:attribute>
   </xs:complexType>
   <xs:complexType name="orderType">
    <xs:sequence>
        <xs:element name="items">
            <xs:complexType>
                <xs:sequence>
                    <xs:element name="item" type="itemType" maxOccurs="unbounded"></xs:element>
                </xs:sequence>
            </xs:complexType>
        </xs:element>
    <xs:element name="payment" type="paymenType"></xs:element>
    </xs:sequence>
    <xs:attribute name="no" type="xs:ID" use="required"></xs:attribute>
    <xs:attribute name="date" type="xs:date" use="required"></xs:attribute>
    <xs:attribute name="customer" type="xs:IDREF" use="required"></xs:attribute>
   </xs:complexType>
   <xs:complexType name="paymenType">
    <xs:sequence></xs:sequence>
    <xs:attribute name="method" type="xs:string" use="required"></xs:attribute>
    <xs:attribute name="paid" type="xs:boolean" use="required"></xs:attribute>
   </xs:complexType>
   <xs:complexType name="itemType">
    <xs:sequence></xs:sequence>
    <xs:attribute name="product" type="xs:IDREF"></xs:attribute>
    <xs:attribute name="quantity" type="plusType" use="required"></xs:attribute>
   </xs:complexType>












   <xs:element name="store">
    <xs:complexType>
        <xs:sequence>
            <xs:element name="catalog">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="product" type="prodType" maxOccurs="unbounded"></xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="customers">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="costumer" maxOccurs="unbounded" type="costumType"></xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="orders">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="order" maxOccurs="unbounded" type="orderType"></xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="name" type="xs:string" use="required"></xs:attribute>
        <xs:attribute name="location" type="xs:string"></xs:attribute>
        <xs:attribute name="created" type="xs:date"></xs:attribute>
    </xs:complexType>
    <xs:unique name="uniqueProductSKU">
        <xs:selector xpath="catalog/product"></xs:selector>
        <xs:field xpath="@sku"></xs:field>
    </xs:unique>
    <xs:key name="uniqueCustomerID">
        <xs:selector xpath="customers/costumer"></xs:selector>
        <xs:field xpath="@id"></xs:field>
    </xs:key>
    <xs:key name="nokey">
        <xs:selector xpath="orders/order"></xs:selector>
        <xs:field xpath="@no"></xs:field>
    </xs:key>
    <xs:keyref name="customerRef" refer="uniqueCustomerID">
        <xs:selector xpath="orders/order"></xs:selector>
        <xs:field xpath="@customer"></xs:field>
    </xs:keyref>
    <xs:keyref name="ref2" refer="uniqueProductSKU">
    <xs:selector xpath="orders/order/items/item"></xs:selector>
    <xs:field xpath="@product"></xs:field>
    </xs:keyref>

   </xs:element>
   
</xs:schema>
